# ---- server ----
GEMINI2API_HOST=127.0.0.1
GEMINI2API_PORT=18610
GEMINI2API_LOG_LEVEL=INFO
# External base URL for media links; empty = derive from request
GEMINI2API_PUBLIC_BASE=

# ---- auth ----
# Empty = auto-generate and store in data/api_key
GEMINI2API_API_KEY=
# Empty = same as API key
GEMINI2API_ADMIN_KEY=
# Allow local access to /dashboard, /admin/* and /v1/* without requiring an API key
GEMINI2API_OPEN_ACCESS=true

# ---- storage ----
GEMINI2API_DATA_DIR=data
# Days of /v1/* request history kept in data/requests.db (pruned hourly)
GEMINI2API_REQUEST_LOG_RETENTION_DAYS=14
# Days generated media files are kept in data/media (pruned hourly; 0 disables)
GEMINI2API_MEDIA_RETENTION_DAYS=14

# ---- driver: mock | browser | http ----
GEMINI2API_DRIVER=browser
# Upstream site base URL (Google AI Studio)
GEMINI2API_SITE_URL=https://aistudio.google.com

# ---- Gemini 4 Argon & Thinking ----
# Default model when client omits model or sends an unknown alias
GEMINI2API_DEFAULT_MODEL=gemini-4-argon
# Default thinking level: high | medium | low | none
GEMINI2API_DEFAULT_THINKING_LEVEL=high
# Also wrap reasoning in <think>...</think> inside content (false = emit in reasoning_content field)
GEMINI2API_THINK_TAGS=false

# ---- browser driver (Chromium + CDP for aistudio.google.com) ----
GEMINI2API_CHROMIUM_PATH=
# Persistent browser profile dir; empty = data/browser-profile
GEMINI2API_BROWSER_PROFILE_DIR=
# Browser-only proxy. Leave empty when aistudio.google.com is reachable directly.
GEMINI2API_BROWSER_PROXY=
# GEMINI2API_BROWSER_PROXY=socks5://127.0.0.1:10808
GEMINI2API_CDP_PORT=19210
GEMINI2API_HEADLESS=true
GEMINI2API_PAGE_READY_TIMEOUT=45
# Pre-started AI Studio tabs kept per account (0 disables)
GEMINI2API_WARM_THREADS=0

# ---- timeouts (seconds) ----
GEMINI2API_CHAT_TIMEOUT=300
GEMINI2API_FIRST_TOKEN_TIMEOUT=90
# SSE ': keepalive' comment interval while waiting for the first stream token;
# 0 disables (default): first token is awaited before the 200 response.
GEMINI2API_STREAM_HEARTBEAT_INTERVAL=0
GEMINI2API_IMAGE_TIMEOUT=240
GEMINI2API_VIDEO_TIMEOUT=600

# ---- account pool ----
# lru | round_robin | affinity
# affinity keeps one user on the same account so the hot page can be reused
GEMINI2API_POOL_STRATEGY=affinity
GEMINI2API_POOL_ACQUIRE_TIMEOUT=60
# Parallel requests per account; the browser driver opens one tab per slot.
GEMINI2API_ACCOUNT_MAX_CONCURRENCY=4
# Seconds an account rests after an upstream error (timeouts excluded).
GEMINI2API_ACCOUNT_COOLDOWN=30
GEMINI2API_MAX_FAILOVER=2

# ---- background removal (images with background="transparent") ----
GEMINI2API_MATTING_MODEL=birefnet-general

# ---- session keepalive ----
GEMINI2API_KEEPALIVE_ENABLED=true
GEMINI2API_KEEPALIVE_INTERVAL=600
